# Copy to .env (deploy.sh generates it for you). Never commit the real .env.
# ── Telegram API (from https://my.telegram.org) ──
TG_API_ID=0
TG_API_HASH=

# ── Identity for file ownership (match the media drive owner) ──
PUID=1000
PGID=1000

# ── Library paths (as seen INSIDE the container; /media = MediaDrive1) ──
HERMES_TV_DIR=/media/TvShows/1080p
HERMES_TV_DIR_4K=/media/TvShows/4K
HERMES_MOVIES_DIR=/media/Movies/1080p
HERMES_MOVIES_DIR_4K=/media/Movies/4K
HERMES_OTHER_DIR=/media/Other
HERMES_MIN_FREE_GB=50

# ── Download performance (install cryptg first — it's in requirements) ──
HERMES_DL_WORKERS=16
HERMES_MAX_CONCURRENT=1
HERMES_DL_CHUNK_MB=1
HERMES_PROGRESS_INTERVAL=1.0

# ── Web / auth ──
HERMES_SECRET_KEY=change-me
HERMES_ADMIN_USER=wishaal
HERMES_ADMIN_PASS=change-me

# ── Optional integrations ──
PLEX_URL=
PLEX_TOKEN=
HERMES_NOTIFY_WEBHOOK=
